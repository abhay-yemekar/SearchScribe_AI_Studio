# ======================================================================
# SearchScribe AI Studio — backend environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ======================================================================

# --- Application ---
# local | production
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---
# SQLite is local/test only. Production requires persistent Postgres, e.g.:
# postgresql+psycopg://searchscribe:searchscribe@localhost:5432/searchscribe
# Neon: keep sslmode=require from its connection string. postgres:// and
# postgresql:// are normalized to the installed psycopg driver.
# Legacy SQLALCHEMY_DATABASE_URL is not read; use DATABASE_URL.
DATABASE_URL=sqlite:///./searchscribe.db

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-.env
ACCESS_TOKEN_EXPIRE_MINUTES=15
GOOGLE_CLIENT_ID=
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Security email (disabled until a personal Brevo sender is verified) ---
MAIL_PROVIDER=disabled
# Trusted canonical origin for email links, never derived from HTTP headers.
# Use https://searchscribe-ai.vercel.app for production; HTTP is local only.
PUBLIC_SITE_URL=http://localhost:3000
MAIL_FROM_NAME=SearchScribe AI
MAIL_FROM_EMAIL=
BREVO_API_KEY=
MAIL_TIMEOUT_SECONDS=10
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
# Persistent email/IP request budgets (per UTC hour) and outgoing mail cap.
SECURITY_EMAIL_REQUESTS_PER_HOUR=3
SECURITY_IP_REQUESTS_PER_HOUR=20
# Keep below Brevo Free's 300/day limit; verification preserves recovery capacity.
MAIL_DAILY_LIMIT=250
MAIL_RECOVERY_RESERVE=50

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI provider ---
# gemini | mock  (mock = deterministic offline provider for dev/tests)
# Production refuses mock. Legacy GEMINI_MODEL_NAME is not read; use AI_MODEL.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8192

# --- Request limits ---
MAX_QUERY_LENGTH=500
MAX_REWRITE_INPUT_LENGTH=20000
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GENERATION_PER_MINUTE=5
