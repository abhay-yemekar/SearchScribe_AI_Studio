# ======================================================================
# SearchScribe AI Studio — backend environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ======================================================================

# --- Application ---
# local | production
APP_ENV=local
LOG_LEVEL=INFO

# --- Database ---
# SQLite is local/test only. Production requires persistent Postgres, e.g.:
# postgresql+psycopg://searchscribe:searchscribe@localhost:5432/searchscribe
# Neon: keep sslmode=require from its connection string. postgres:// and
# postgresql:// are normalized to the installed psycopg driver.
# Legacy SQLALCHEMY_DATABASE_URL is not read; use DATABASE_URL.
DATABASE_URL=sqlite:///./searchscribe.db

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-.env
ACCESS_TOKEN_EXPIRE_MINUTES=15
GOOGLE_CLIENT_ID=
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Security email (disabled until a personal Brevo sender is verified) ---
MAIL_PROVIDER=disabled
# Enable only after Brevo per-contact tracking consent is activated and
# delivered security links are verified to remain untracked. False keeps codes.
SECURITY_EMAIL_LINKS_ENABLED=false
# Trusted canonical origin for email links, never derived from HTTP headers.
# Use https://searchscribe-ai.vercel.app for production; HTTP is local only.
PUBLIC_SITE_URL=http://localhost:3000
MAIL_FROM_NAME=SearchScribe AI
MAIL_FROM_EMAIL=
BREVO_API_KEY=
MAIL_TIMEOUT_SECONDS=10
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_EXPIRE_HOURS=24
# Persistent email/IP request budgets (per UTC hour) and outgoing mail cap.
SECURITY_EMAIL_REQUESTS_PER_HOUR=3
SECURITY_IP_REQUESTS_PER_HOUR=20
# Keep below Brevo Free's 300/day limit; verification preserves recovery capacity.
MAIL_DAILY_LIMIT=250
MAIL_RECOVERY_RESERVE=50

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- AI provider ---
# gemini | groq | mock  (mock = deterministic offline provider for dev/tests)
# Production refuses mock. Legacy GEMINI_MODEL_NAME is not read; use AI_MODEL.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
AI_TIMEOUT_SECONDS=60
# One shared wall-clock budget for research, AI retries, fallback and SEO repair.
# Database commits/rendering have their own lifecycle, outside this external-call budget.
AI_OPERATION_TIMEOUT_SECONDS=100
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8192

# Optional availability fallback; blank = disabled. Configure both fields together.
# Uses the same query/source bundle once after transient primary failures only.
# Same-provider model fallback reuses its existing key; different-provider fallback
# needs that personal provider's secret. No model is selected from the topic.
# Benchmark an exact model ID before enabling; keep provider accounts on Free.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=

# Groq is opt-in; no live calls without its key and explicit provider selection.
# Published Free limits vary by model/account. Never truncate source evidence to fit.
GROQ_API_KEY=
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_MAX_INPUT_CHARS=20000
GROQ_MAX_RESPONSE_BYTES=512000
# Blank omits the parameter. Set only a value supported by your selected model.
GROQ_REASONING_EFFORT=
# Prefer strict JSON schema when the selected model supports it.
GROQ_JSON_MODE=json_schema

# --- Dynamic web research ---
# Personal Tavily Free key; backend only. Never use NEXT_PUBLIC_* for this key.
# Keep paid/PAYG disabled. Original basic query plus at most one complementary
# advanced query (up to 3 Tavily credits per draft); no recursive search.
# One 15-second call plans intent before search, then a 20-second evidence review
# checks source scope/passages before drafting; all share the operation deadline.
# Mock stays fully offline.
# Without a key, timely queries fail clearly instead of inventing current facts.
TAVILY_API_KEY=
# Blank pair reuses AI_PROVIDER/AI_MODEL. Set both for a separately validated
# planner role; this does not enable article fallback or change the article model.
RESEARCH_PLANNER_PROVIDER=
RESEARCH_PLANNER_MODEL=
# Optional evidence-selection role; blank reuses the planner (or article provider).
# Groq reviewers use JSON-object mode plus local schema/passage-ID validation.
RESEARCH_REVIEWER_PROVIDER=
RESEARCH_REVIEWER_MODEL=
RESEARCH_TIMEOUT_SECONDS=12
RESEARCH_MAX_RESULTS=5
RESEARCH_MAX_RESPONSE_BYTES=512000
RESEARCH_MAX_CONTEXT_CHARS=24000
RESEARCH_MAX_EXCERPT_CHARS=4000
RESEARCH_MIN_SCORE=0.3
# Recent reporting requires dated sources within this UTC window. Current reference
# discovery keeps maintained documents with older/unknown dates; this isn't proof of freshness.
# Today searches use today's UTC date; explicit historical dates are not narrowed to now.
RESEARCH_RECENT_DAYS=30

# --- Request limits ---
MAX_QUERY_LENGTH=500
MAX_REWRITE_INPUT_LENGTH=20000
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GENERATION_PER_MINUTE=5
