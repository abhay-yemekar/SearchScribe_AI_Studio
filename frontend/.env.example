# Manual local development: API started on 127.0.0.1:8000.
# This is server-only; never add provider keys or use NEXT_PUBLIC_* for them.
BACKEND_URL=http://127.0.0.1:8000

# Server-only, same value as the API's PROXY_SHARED_SECRET. On Vercel, proxy.ts
# sends it to the API with the visitor's IP so rate limits are per client.
# Leave blank locally; it is never needed outside Vercel.
PROXY_SHARED_SECRET=

# Optional browser error tracking (Sentry Browser JavaScript project DSN).
# Public by design, and read at build time: set it on Vercel, then rebuild.
# Blank keeps Sentry off and out of the CSP's connect-src.
NEXT_PUBLIC_SENTRY_DSN=

# The runapp.ps1 mock preview sets BACKEND_URL in its child process instead.
# Production Vercel config uses the deployed personal Render API URL.
